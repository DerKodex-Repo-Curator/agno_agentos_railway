# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-***

# ---------------------------------------------------------------------------
# JWT verification for AgentOS. Generate your JWT_VERIFICATION_KEY at os.agno.com.
# In production (RUNTIME_ENV != dev), the app refuses to serve traffic without
# JWT_VERIFICATION_KEY or JWT_JWKS_FILE. Local dev (RUNTIME_ENV=dev) is ok without it.
# Set `authorization=False` in app/main.py to opt out (not recommended).
# ---------------------------------------------------------------------------
# Quote the value so parsers read the multi-line PEM as one variable:
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json

# ---------------------------------------------------------------------------
# AgentOS URL used by the scheduler and MCP server.
# Set this to the public URL of your AgentOS instance. It applies to files you
# carry elsewhere (.env.production): the local compose stack pins its own value
# in compose.yaml, which overrides anything set here.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# MCP OAuth — set MCP_CONNECT_SECRET to turn the /mcp endpoint into its own
# OAuth 2.1 authorization server, which is how claude.ai and ChatGPT (web) connect.
# Connecting to the MCP server asks for this secret on a consent page.
# Generate a strong one (≥16 chars):
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
# MCP_CONNECT_SECRET=

# Optional: pin the OAuth token signing key (≥32 chars). Unset, a strong key is
# generated and persisted in the database. Rotating it invalidates outstanding tokens.
# AGENTOS_MCP_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Agno's and the Studio registry's web search tools use the Parallel SDK
# when authenticated, and fall back to Parallel's keyless MCP server otherwise.
# ---------------------------------------------------------------------------
# PARALLEL_API_KEY=

# ---------------------------------------------------------------------------
# Schedules
# ---------------------------------------------------------------------------
# ENABLE_DEPLOY_CHECK=True
# EVALS_TAG=smoke
# EVALS_CASE_TIMEOUT_SECONDS=90
# EVALS_SUITE_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Slack — set both to enable the Slack interface.
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Signing Secret (Basic Information → App Credentials)
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Local development
#
# compose.yaml sets both for the local stack, so they are only needed in a file
# you carry elsewhere — README's Railway path copies this file to
# .env.production, where nothing sets them for you.
#   AGNO_DEBUG   True turns on agno's verbose debug logging.
#   WAIT_FOR_DB  True blocks the entrypoint on Postgres before serving.
# ---------------------------------------------------------------------------
# AGNO_DEBUG=False
# WAIT_FOR_DB=False

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg

# Durable runs live in Postgres; Redis coordinates events and cancellation.
# Host dev uses port 6380 by default, Compose uses agentos-redis:6379.
# REDIS_URL=redis://127.0.0.1:6380/0
# REDIS_PORT=6380
# PORT=8000

# Company weekly Summary: requires both Slack credentials above and a channel ID.
# Without a destination the weekly routine writes the Product status page only.
# SLACK_SUMMARY_CHANNEL=C0123456789

# Sandboxes: dev API must run on the host with ./scripts/dev.sh.
# SANDBOX_ENABLED=true
# SANDBOX_IMAGE=agno-sandbox:local
# SANDBOX_CHECKPOINTS=./tmp/checkpoints
# Production: one AgentCore runtime per deployment, checkpoints on a persistent
# mounted volume, ONE API replica until the object-store checkpoint store ships.
# SANDBOX_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:175651002206:runtime/...
# SANDBOX_CHECKPOINTS=/data/checkpoints
# AWS_REGION=us-east-1
# AWS_PROFILE=agno-staging-agentcore
# Alternatively configure AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN on the host; do not forward host credentials to the sandbox.
# Local Claude uses ANTHROPIC_API_KEY; production Claude uses the runtime Bedrock role.
# ANTHROPIC_API_KEY=
# GITHUB_READ_TOKEN=       # optional, read-only contents on one private repository; enters sandbox
# GITHUB_TOKEN=            # host-only future PR publication; never enters sandbox
# SANDBOX_RUNTIME_NAME=agno_company_engineer
# SANDBOX_EXECUTION_ROLE=arn:aws:iam::175651002206:role/agno-agentcore-runtime-staging
