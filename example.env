# Required for the application model and knowledge embeddings.
OPENAI_API_KEY=sk-***

# Production requires JWT verification. Never sync RUNTIME_ENV=dev to production.
# Quote multi-line PEM values. A JWKS file is an alternative to the public key.
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json
# AGENTOS_URL=https://your-agentos.example.com

# Optional MCP OAuth; otherwise MCP uses the API's authentication.
# MCP_CONNECT_SECRET=             # at least 16 random characters
# AGENTOS_MCP_SIGNING_KEY=         # optional stable signing material, at least 32 characters
# If unset, Agno generates a strong key and persists it in PostgreSQL across redeploys.

# PostgreSQL. Compose supplies its own local connection settings.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg

# Optional interfaces and web access.
# PARALLEL_API_KEY=               # absent: keyless web MCP
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=           # both Slack values enable the interface

# Development. Compose sets RUNTIME_ENV=dev; set it explicitly for a host API.
# PORT=8000
# AGNO_DEBUG=False
# WAIT_FOR_DB=False

# Engineers run on the AgentOS server by default. Optional sandboxes:
# Docker locally, AgentCore in production. Repository, branch and checkpoint paths
# are defined in app/sandbox.py.
# SANDBOX_ENABLED=true            # development only; API runs on the host
# SANDBOX_IMAGE=agno-sandbox:local
# ANTHROPIC_API_KEY=              # server-hosted/local Claude authentication
# GITHUB_READ_TOKEN=              # optional private-repository read token; enters sandbox

# Production: one API replica, mount a persistent volume at /data for checkpoints.
# SANDBOX_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT:runtime/...
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
# Alternatively use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# on the host. Host AWS credentials are not forwarded to the sandbox.
